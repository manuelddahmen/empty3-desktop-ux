# --- Build stage ---
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# --- Production stage ---
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Replace 'listen 80;' with 'listen $PORT;' in the default Nginx config
# We use a shell script or 'envsubst' to dynamically set the port at runtime
# or sed at build time. Here is the simplest approach for Cloud Run:
RUN sed -i 's/listen       80;/listen       ${PORT};/' /etc/nginx/conf.d/default.conf

# We need to use envsubst to replace $PORT when the container starts
# because Nginx doesn't natively support environment variables in listen directives.
# Alternatively, change the command to:
CMD /bin/sh -c "sed -i 's/listen       80;/listen       '"$PORT"';/' /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
